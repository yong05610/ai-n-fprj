CORS_ORIGINS=http://localhost:3000
# Local development without Firebase: AUTH_MODE=dev accepts "dev-<uid>" tokens, STORE_BACKEND=memory keeps data in process memory.
# Deployment: AUTH_MODE=firebase and STORE_BACKEND=firestore (dev auth is refused on Render).
# WARNING: local only, do not use in deployment. The app refuses to start with either value when RENDER is set.
AUTH_MODE=dev
STORE_BACKEND=memory
# Add credentials only to your local ignored .env or deployment secret settings.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# OPENAI_API_KEY=
# Path/plan generation (Phase 4). Defaults are used when these are left unset.
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_SECONDS=20
# OPENAI_MAX_OUTPUT_TOKENS=1500
# Whole-course plan generation (Phase 5F) is a much longer answer, so it has its own limits.
# OPENAI_PLAN_TIMEOUT_SECONDS=60
# OPENAI_PLAN_MAX_OUTPUT_TOKENS=8000
# Deployment (Render) only: with RENDER set the app refuses to start unless CORS_ORIGINS is https-only
# (no *, no localhost, no trailing slash) and both secrets above are set.
# /docs, /redoc and /openapi.json are on by default; set to false to turn them off (e.g. before inviting testers).
# API_DOCS_ENABLED=true
# Reference material read path (Phase 8B). "file" (default) reads only backend/data/rag_documents.json, as before.
# "file+approved" also reads the admin-approved documents of Firestore learning_documents (60 s cache).
# To go back, set it to file (no data is changed). Any other value means file.
# RESOURCE_READ_SOURCE=file

# Reference material collection (Phase 8B, admin only). Every default is off.
# COLLECTORS_ENABLED=direct_link,ai_topic   (empty = all collectors off; calling an off collector is a 409)
# COLLECTOR_DAILY_CANDIDATES=20             (per collector and Asia/Seoul day; automatic rejections count)
# COLLECTOR_AI_TOPIC_DAILY_RUNS=5
# FIELD_STATS_ENABLED=false                 (field demand numbers for admins; needs the terms version that announces them)
# FIELD_STATS_MIN_USERS=3                   (fields with fewer different users are left out; never below 2)

