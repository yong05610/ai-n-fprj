CORS_ORIGINS=http://localhost:3000
# Local development without Firebase: AUTH_MODE=dev accepts "dev-<uid>" tokens, STORE_BACKEND=memory keeps data in process memory.
# Deployment: AUTH_MODE=firebase and STORE_BACKEND=firestore (dev auth is refused on Render).
# WARNING: local only, do not use in deployment. The app refuses to start with either value when RENDER is set.
AUTH_MODE=dev
STORE_BACKEND=memory
# Add credentials only to your local ignored .env or deployment secret settings.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# OPENAI_API_KEY=
