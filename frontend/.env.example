# --- Local development ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
# "dev" runs without Firebase (backend must also use AUTH_MODE=dev). Use "firebase" for real auth.
NEXT_PUBLIC_AUTH_MODE=dev

# --- Deployment (Vercel project environment variables; set them in the console, never commit values) ---
# NEXT_PUBLIC_API_BASE_URL  the Render API address, https only, no trailing slash. A production build
#                           without it (or with a non-https address) shows a setup error and sends no requests.
# NEXT_PUBLIC_AUTH_MODE     leave unset (or "firebase") in deployment. "dev" shows a warning band.
# NEXT_PUBLIC_FIREBASE_*    the four names below, all from the same Firebase project as the backend.

# Firebase web app config (public identifiers, not secrets). Required when NEXT_PUBLIC_AUTH_MODE=firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
